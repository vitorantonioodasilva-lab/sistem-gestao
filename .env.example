# Postgres (Neon, Supabase ou Vercel Postgres). As tabelas se criam sozinhas.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Aplicação criada em https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser IDÊNTICO ao cadastrado no DevCenter
ML_REDIRECT_URI=https://seu-app.vercel.app/api/ml/callback

# Senha de acesso ao painel (obrigatória: o painel mostra dados financeiros)
APP_PASSWORD=

# Segredo do cron da Vercel (opcional)
CRON_SECRET=

# Outro país? MLA: https://auth.mercadolibre.com.ar
ML_AUTH_HOST=https://auth.mercadolivre.com.br

# Diagnóstico por IA (opcional). Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Site do Mercado Livre. MLB = Brasil. Só mude se vender em outro país.
ML_SITE_ID=MLB
